# Copy to .env.local and fill in. Never commit real secrets: this repo is public.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Public URL used for metadata, sitemap and OG links. On Vercel it falls back to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Example server-only secret (read it only in Server Components, Route Handlers, Server Actions):
# API_KEY=
