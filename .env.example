# Copy to .env.local and fill in. Never commit real secrets: this repo is public.
# Server-side variables are validated in src/lib/env.ts; add new ones there too.
# Only variables prefixed with NEXT_PUBLIC_ reach the browser.

# Backend API. Used by src/lib/api.ts (server) and the /api/backend proxy (src/proxy.ts).
# Without it the tasks example runs on an in-memory demo store.
# API_URL=https://backend-production-29d30b12.up.railway.app
# Only if the backend requires a server-to-server key. Never commit it.
# API_KEY=

# Override the public site URL (metadata, sitemap, OG links).
# Usually not needed: on Vercel it is derived from the deployment, locally it is http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://example.com
